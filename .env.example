# Edge Function secrets. Set them with `supabase secrets set NAME=value`
# (never commit real values). SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are injected by Supabase.
SUPABASE_PROJECT_REF=            # used by scripts/*.sh, from the Supabase dashboard URL
TELEGRAM_BOT_TOKEN=              # from @BotFather (scripts/setup-telegram.sh sets it)
TELEGRAM_WEBHOOK_SECRET=         # random string (scripts/setup-telegram.sh generates it)
BOT_USERNAME=                    # your bot's username without @
MINIAPP_URL=                     # https://<user>.github.io/<pages-repo>/  (trailing slash)
DB_REGION=                       # shown in the consent text, e.g. "Frankfurt"
OPERATOR_CONTACT=                # shown in the consent text, e.g. "@my_bot owner, me@example.com"
GEMINI_API_KEY=                  # Google AI Studio key (coach, voice, photos)
GEMINI_MODEL=                    # optional, tried first
GITHUB_TOKEN=                    # optional, read:user, for the "Projects" contribution graph
